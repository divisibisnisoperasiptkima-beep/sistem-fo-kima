# Salin file ini menjadi backend/.env dan isi kredensial lokal Anda.
# Jangan commit backend/.env.
DATABASE_URL=mysql://fo_kima_user:CHANGE_ME@127.0.0.1:3306/fo_kima
JWT_SECRET=generate-a-long-random-secret-for-this-environment
BIND_ADDR=127.0.0.1:8080
RUST_LOG=info,tower_http=info

# Google Drive (OAuth server-side; token tidak dikirim ke browser)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_LINK_SHARING=true
PELANGGAN_ROOT_FOLDER_ID=
