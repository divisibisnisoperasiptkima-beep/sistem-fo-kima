# Salin file ini menjadi backend/.env dan isi kredensial lokal Anda.
# Jangan commit backend/.env.
DATABASE_URL=mysql://fo_kima_user:CHANGE_ME@127.0.0.1:3306/fo_kima
JWT_SECRET=generate-a-long-random-secret-for-this-environment
BIND_ADDR=127.0.0.1:8080
RUST_LOG=info,tower_http=info
# Batas ukuran isi file; backend menambahkan ruang untuk overhead multipart.
MAX_UPLOAD_BYTES=26214400
# Aktifkan hanya jika backend tidak dapat diakses langsung dan berada di belakang proxy tepercaya.
TRUST_PROXY_HEADERS=false
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECS=60
LOGIN_RATE_MAX_IPS=10000

# Google Drive (OAuth server-side; token tidak dikirim ke browser)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_LINK_SHARING=false
PELANGGAN_ROOT_FOLDER_ID=

# Backup database terenkripsi ke Google Drive
BACKUP_ENABLED=false
BACKUP_TIMEZONE=Asia/Makassar
BACKUP_SCHEDULE_HOUR=2
BACKUP_SCHEDULE_MINUTE=0
BACKUP_FOLDER_NAME=Backup
BACKUP_DATABASE_FOLDER_NAME=Database
BACKUP_RETENTION_DAILY=7
# Buat dengan: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=
# Opsional; wajib diisi untuk pengujian restore. Gunakan user MySQL terpisah
# yang memiliki CREATE/DROP DATABASE dan jangan arahkan ke database produksi.
BACKUP_RESTORE_DATABASE_URL=mysql://fo_kima_restore_user:CHANGE_ME@127.0.0.1:3306/fo_kima_restore_admin
BACKUP_MAX_RESTORE_BYTES=2147483648
